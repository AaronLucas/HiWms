# Supabase Configuration
# Copy this file to .env and fill in your values
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: For local development
# SUPABASE_URL=http://localhost:54321
# SUPABASE_ANON_KEY=your-local-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Optional: CORS 允许来源，逗号分隔，tenant-api / admin-api 各自独立配置
# （device-api 是设备原生 HTTP 调用，不经过浏览器，不需要 CORS）。
# 生产环境未配置时不放行任何跨域来源（fail closed）；非生产环境有本地开发默认值。
# TENANT_API_ALLOWED_ORIGINS=https://app.example.com
# ADMIN_API_ALLOWED_ORIGINS=https://admin.example.com

# Optional: CAPTCHA provider — must match whatever is actually configured under
# Supabase Cloud Dashboard → Authentication → Attack Protection for this project.
# Purely for logging/observability; does not gate signIn/signUp behavior — the
# captchaToken passthrough is provider-agnostic (see OPS.md §5.4).
# Leave unset when Attack Protection is off. One of: hcaptcha | turnstile
# CAPTCHA_PROVIDER=hcaptcha